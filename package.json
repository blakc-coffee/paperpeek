{
  "name": "paperpeek",
  "version": "0.0.0",
  "private": true,
  "description": "Hover any symbol, AI/ML term or figure in a paper to see its definition, diagrams, figures and demos.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:ext": "web-ext lint -s .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "7.0.2",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "0.21.5"
  }
}
